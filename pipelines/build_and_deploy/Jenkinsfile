// Pipeline Build and Deploy Server and Clients
@Library('mytaverse') _

pipeline {

    agent {
        label "_mytaverse && windows"
    }

    options {
        timestamps()
        parallelsAlwaysFailFast()
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'BUILD_LINUX_SERVER', defaultValue: true, description: 'Use Linux for server')
        booleanParam(name: 'ENABLE_CLIENT_GAMECAST', defaultValue: false, description: 'Build and deploy GameCast client')
        booleanParam(name: 'ENABLE_CLIENT_PUREWEB', defaultValue: false, description: 'Build and deploy PureWeb client')
        // 
        choice(name: 'AWS_INSTANCE_TYPE', choices: ['c5.2xlarge', 'c5.xlarge', 'c5.large'])
        choice(name: 'PLASTICSCM_CLEANUP_STRATEGY', choices: ['STANDARD', 'MINIMAL', 'FULL', 'DELETE'])
        choice(name: 'SERVER_CONFIG', choices: ['Shipping', 'Development'])
        choice(name: 'TARGET_CONNECTION', choices: ['CC_Dev', 'CC_Prod'])
        // 
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS Region to which the build will be deployed')
        string(name: 'PACKAGE_PATH', defaultValue: 'D:/jenkins_yvokov/artifacts/Mytaverse/Server', description: 'Artifact storage root directory.')
        string(name: 'MODEL_NAME', defaultValue: 'Mytaverse51Dev', description: 'Viktor to add description for this variable')
        string(name: 'MAPS_CONFIG_NAME', defaultValue: '51Devtest', description: 'Viktor to add description for this variable')
        string(name: 'PLASTICSCM_CHANGESET', defaultValue: '', description: 'PlasticSCM Changeset to be used for build and deploy.')
        string(name: 'PLASTICSCM_BRANCH', defaultValue: '/Main/TourLabs', description: 'PlasticSCM Branch.')
        string(name: 'SERVER_BUILD_FLAGS', defaultValue: '-build -cook -package -stage -archive -pak -allmaps -server -noclient -target=MytaverseServer')
        string(name: 'UE_ENGINE', defaultValue: 'D:/ue5_source/ue_52', description: 'Viktor to add description for this variable')
    }

    environment {
        GIT_CREDENTIALS_ID = 'gh-deploy-key'
        CRED_CICD = credentials('cicd_server')
        LINUX_BUILD_ROOT = "${env.PACKAGE_PATH}/${env.PACKAGE_NUMBER}/LinuxServer"
        OPERATING_SYSTEM = "${params.BUILD_LINUX_SERVER ? "AMAZON_LINUX_2" : "WINDOWS_2012"}" // was: GAMELIFT_SERVER_OS 
        PACKAGE_NUMBER = "${env.BUILD_NUMBER}"
        PLATFORM = "${params.BUILD_LINUX_SERVER ? "Linux" : "Win64"}" // was: GAMELIFT_PLATFORM
        PLASTICSCM_TARGET_SERVER = 'Mytaverse@cloud'
        PLASTICSCM_TARGET_REPOSITORY = 'Paradox'
        PLASTICSCM_LOCAL_PATH = "${env.WORKSPACE}/${env.PLASTICSCM_TARGET_REPOSITORY}"
        PROJECT_PATH = "${env.PLASTICSCM_LOCAL_PATH}" + '/Mytaverse.uproject'
        SERVER_BUILD_ROOT = "${env.PACKAGE_PATH}/${env.PACKAGE_NUMBER}/WindowsServer"
        UAT_PATH = "${UE_ENGINE}" + "/Engine/Build/BatchFiles/RunUAT.bat"

        buildFolder = "${params.BUILD_LINUX_SERVER ? "${env.LINUX_BUILD_ROOT}" : "${env.SERVER_BUILD_ROOT}"}"
    }

    stages {
        stage("Send slack notification") {
            steps {
                echo "Sending slack notification"
            }
        }

        stage('Checkout PlasticSCM'){
            steps {
                // TODO: Define ChangeSet
                // Consider whether the step should be here or as part of the
                // PlasticSCM library
                echo "TODO: Resolve the latest-stable mess made by .net"
                echo "Defining Changeset Number"
                echo "File: ue5-pipelines/parallel/Jenkinsfile"
                echo "Pipeline name: DevGit "
                echo "Invoke pipeline: 'GetLatestStable'"

                // TODO: Uncomment build
                // script {
                //     plasticVars = cm(
                //         branch:         "${params:PLASTICSCM_BRANCH}",
                //         changeset:      "${env:PLASTICSCM_CHANGESET}",
                //         cleanup:        "${env:PLASTICSCM_CLEANUP_STRATEGY}",
                //         changelog:      true,
                //         credentialsId:  "${env.GIT_CREDENTIALS_ID}",
                //         poll:           false,
                //         repository:     "${env.PLASTICSCM_TARGET_REPOSITORY}",
                //         server:         "${env.PLASTICSCM_TARGET_SERVER}",
                //         workingMode:    "LDAP",
                //         directory:      "${env.PLASTICSCM_LOCAL_PATH}"
                //     )

                //     env.PLASTICSCM_AUTHOR           = plasticVars["PLASTICSCM_AUTHOR"]
                //     env.PLASTICSCM_CHANGESET_ID     = plasticVars["PLASTICSCM_CHANGESET_ID"]
                //     env.PLASTICSCM_CHANGESET_GUID   = plasticVars["PLASTICSCM_CHANGESET_GUID"]
                // }
            }
        }

        stage('Setup dynamic environment') {
            steps {
                script {
                    switch(params.TARGET_CONNECTION) {
                        case 'CC_Prod':
                            env.SENTRY_URL = "https://fa82a796bfbe4f699d63480130b8ed4a@o993426.ingest.sentry.io/4504445385244672"
                            env.AWS_DEPLOY_CREDENTIALS = "aws-jenkins-prod"
                            break
                        case 'CC_Dev':
                            env.SENTRY_URL = "https://daeb6c5130c6475abd4eb91857c3352e@o993426.ingest.sentry.io/4505125043503104"
                            env.AWS_DEPLOY_CREDENTIALS = "aws-jenkins-dev"
                            break
                        default:
                            env.SENTRY_URL = "not_setup"
                            break
                    }
                    switch(params.CHANGESET_TYPE) {
                        case 'latest-stable':
                            // execute code to define latest stable
                            bat "dir"
                            break
                        default:
                            break
                    }
                    // Print all variables for debugging reasons
                    if (isUnix()) {
                        sh '''env'''
                    }
                    else {
                        powershell '''dir env:'''
                    }
                }
            }
        }

        stage("Building and Deploy Server and Clients") {
            parallel {
                stage('Server GameLift Build and Deploy') {
                    stages {
                        stage('Server GameLift Build') {
                            steps {
                                echo "Server GameLift Build"
                                echo "Currently invoke external Pipeline - 'GameLift'"
                                echo "TODO: Should setup: serverPlasticChangeSet"
                                // New  Code
                                echo "Server GameLift Build"
                                echo "OPERATING_SYSTEM: ${env.OPERATING_SYSTEM}"
                                echo "PLATFORM: ${env.PLATFORM}"
                                dir("${env.PLASTICSCM_LOCAL_PATH}"){
                                    // TODO: Uncomment for production
                                    // echo "Skipping build to test variables
                                    // gameliftBuild()
                                }
                            }
                        }
                        stage('Copy Build to AWS Build folder') {
                            when {
                                expression  {params.BUILD_LINUX_SERVER == false }
                            }
                            steps {
                                powershell '''
                                    $buildSourceDir = Join-Path ${env:PLASTICSCM_LOCAL_PATH} Build `
                                        | Join-Path -ChildPath WindowsServer
                                    $buildDestDir = Join-Path ${env:PACKAGE_PATH} ${env:BUILD_NUMBER} `
                                        | Join-Path -ChildPath WindowsServer
                                    $cmdXCopy = "& XCopy $buildSourceDir $buildDestDir /E /H /C /I"

                                    Write-Host Command to copy build: $cmdXCopy
                                    Invoke-Expression $cmdXCopy
                                '''
                            }
                        }
                        stage('Clean Fleets'){
                            steps {
                                script {
                                    withCredentials([aws(
                                                    credentialsId: env.AWS_DEPLOY_CREDENTIALS,
                                                    accessKeyVariable: '_AWS_ACCESS_KEY_ID',
                                                    secretKeyVariable: "_AWS_SECRET_ACCESS_KEY")]) {
                                        dir("${env:PLASTICSCM_LOCAL_PATH}") {
                                            powershell '''
                                                $cleanFleetExe = Join-Path ${env:PLASTICSCM_LOCAL_PATH} Devops `
                                                    | Join-Path -ChildPath aws `
                                                    | Join-Path -ChildPath AWSHelper.exe
                                                $cmdFleetCmd = "& $cleanFleetExe" + `
                                                    "${env:_AWS_ACCESS_KEY_ID}" + ` 
                                                    " ${env:_AWS_SECRET_ACCESS_KEY}"  + `
                                                    " ${env:AWS_REGION}"

                                                Write-Host "Clean Fleets Command: $cmdFleetCmd"
                                                # TODO: Uncomment for production
                                                # Invoke-Expression $cmdFleetCm
                                            '''
                                        }
                                    }
                                }
                            }
                        }
                        stage('Define AWS Runtime params and other vars') {
                            steps {
                                script {
                                    env.test = gameliftRuntimeConfig(
                                        os:      "${env.OPERATING_SYSTEM}",
                                        config:  "${env.SERVER_CONFIG}", 
                                        concExe: "${env.AWS_CONCURRENT_EXECUTIONS}",
                                    )
                                    env.runTimeConfig = "ServerProcesses=${env.test}"
                                    echo "runTimeConfig is ${env.runTimeConfig}"
                                }
                            }
                        }
                        stage('Server GameLift Deploy'){
                            steps {
                                gameliftDeploy()
                            }
                        }
                    }
                }
                stage('Client GameCast Build and Deploy') {
                    when {
                        expression {params.ENABLE_CLIENT_GAMECAST == true }
                    }
                    stages {
                        stage('Client GameCast Build') {
                            steps {
                                echo "Deploy Client GameCast"
                                echo "Currently invoke external Pipeline - 'GameCast'"
                                gamecastBuild()
                            }
                        }
                        stage('Client GameCast Deploy') {
                            steps {
                                gamecastDeploy()
                            }
                        }
                    }
                }

                stage('Client PureWeb Build and Deploy') {
                    when {
                        expression {params.ENABLE_CLIENT_PUREWEB == true}
                    }
                    stages {
                        stage('Client Pureweb Build') {
                            steps {
                                echo "Deploy Client PureWeb"
                                echo "Currently stage 'Client Plastic clone PureWeb'"
                                echo "Currently stage 'Build Pure Web'"
                                echo "Currently stage 'Define Zip name'"
                                echo "Currently stage 'ZiP artifacts'"
                                echo "Currently invoke external Pipeline - 'Pure Web'"
                                purewebBuild()
                            }
                        }
                        stage('Client Pureweb Deploy') {
                            steps {
                                purewebDeploy()
                            }
                        }
                    }
                }
            }
        }

    }
    post {
        always {
            echo "Pipeline Finished."
        }
        
        success {
            echo "Finished successfully."
        }

        failure {
            echo "Failed."
        }
    }
}
